# Copy to .env and adjust. docker-compose reads this automatically.
# ---------------------------------------------------------------------------

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=xeno
POSTGRES_PASSWORD=xeno
POSTGRES_DB=xenopulse
DB_PORT=5432
# password for the auto-created read-only role (see db/schema.sql)
READONLY_PASSWORD=xeno_readonly_pw

# --- Ports --------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=8080

# --- AI Analyst ---------------------------------------------------------
# Optional. Without a key the AI Analyst falls back to a deterministic
# rule-based NL->SQL mapper (works fully offline for the demo).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Safety limits (applied to user / AI supplied SQL) ---------------------
QUERY_ROW_LIMIT=1000
STATEMENT_TIMEOUT_MS=8000

# --- CORS (frontend origins allowed to call the API) --------------------
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
